#jinja2: lstrip_blocks: True
vrrp_script check_haproxy {
  script "/usr/bin/wget -q --spider -T 1 http://127.0.0.1:{{ __haproxy_monitor_port }}/healthz"
  interval 1
  fall 2
  rise 2
}

vrrp_instance HAPROXY {
  state BACKUP
  interface {{ haproxy_keepalived_vrrp_interface }}
  {% if haproxy_keepalived_unicast_peers %}
  unicast_src_ip {{ haproxy_keepalived_unicast_src_ip }}
  unicast_peer {
    {% for peer in haproxy_keepalived_unicast_peers %}
    {{ peer }}
    {% endfor %}
  }
  check_unicast_src
  {% endif %}
  virtual_router_id {{ haproxy_keepalived_virtual_router_id }}
  priority 100
  advert_int 1
  nopreempt
  virtual_ipaddress {
    {{ haproxy_keepalived_virtual_ip_address }} dev {{ haproxy_keepalived_vip_interface }}
  }

  track_script {
    check_haproxy
  }
}
