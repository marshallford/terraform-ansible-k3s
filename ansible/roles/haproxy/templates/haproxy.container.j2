#jinja2: lstrip_blocks: True
[Container]
ContainerName=haproxy
Image=haproxy.image
UserNS=keep-id:uid=99,gid=99
NoNewPrivileges=true
ReadOnly=true
Volume=haproxy.volume:/usr/local/etc/haproxy:ro,Z
ReloadSignal=SIGHUP

[Unit]
Requires=%N.socket

[Service]
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=default.target
