#jinja2: lstrip_blocks: True
[Container]
ContainerName=keepalived
Image=keepalived.image
Network=host
DropCapability=all
AddCapability=NET_ADMIN NET_BROADCAST NET_RAW SETUID SETGID
NoNewPrivileges=true
ReadOnly=true
Volume=keepalived.volume:/etc/keepalived:ro,Z

[Service]
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=default.target
