#jinja2: lstrip_blocks: True
vrrp_script check_haproxy {
  script "/usr/bin/wget -q --spider -T 1 http://127.0.0.1:{{ __haproxy_monitor_port }}/healthz"
  interval 1
  fall 2
  rise 2
}

vrrp_instance HAPROXY {
  state BACKUP
  interface {{ __haproxy_keepalived_vrrp_interface }}
  virtual_router_id {{ __haproxy_keepalived_virtual_router_id }}
  priority 100
  advert_int 1
  nopreempt
  virtual_ipaddress {
    {{ __haproxy_keepalived_virtual_ip_address }} dev {{ __haproxy_keepalived_vip_interface }}
  }

  track_script {
    check_haproxy
  }
}
