#jinja2: lstrip_blocks: True
global
  log stdout format raw local0 notice

defaults
  mode tcp
  log global
  option dontlognull
  timeout connect 10s
  timeout client 4h
  timeout server 4h

frontend main
  bind fd@3
  option tcplog
  default_backend machines

frontend monitor
  bind fd@4
  mode http
  no log
  monitor-uri /healthz

backend machines
  balance roundrobin
  option httpchk GET /readyz
  http-check expect status 200,401
  default-server inter 5s fall 2 rise 1 check check-ssl verify none
  {% for server in __haproxy_backend_servers %}
  server {{ server[0] }} {{ (server[0] == inventory_hostname) | ternary('host.containers.internal', server[1]) }}:{{ __haproxy_backend_port }}
  {% endfor %}
